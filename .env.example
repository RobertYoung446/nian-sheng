# Optional Stripe sandbox configuration for Pro subscriptions.
ALLOW_NEW_SUBSCRIPTIONS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# WeChat Open Platform website app OAuth (server-side only)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
